<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#080808">
<title>Aromas Art — Catálogo de Perfumes</title>
<style>
:root{--bg:#080808;--card:#141414;--red:#e11d2e;--text:#fff;--muted:#b8b8b8}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:85px}
body{margin:0;background:radial-gradient(ellipse at top,#25080b 0,#090909 42%,#050505 100%);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
.wrap{max-width:1150px;margin:auto;padding:0 18px}
header{position:sticky;top:0;z-index:5;background:#080808ed;backdrop-filter:blur(14px);border-bottom:1px solid #3a161a}
.nav{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{font-size:21px;font-weight:800}.brand span,.hero h1 span{color:var(--red)}
.nav a{color:#eee;text-decoration:none;font-size:14px}
.hero{text-align:center;padding:60px 0 35px}
.badge{display:inline-block;border:1px solid #7d1b25;color:#ff6873;background:#1b080a;padding:7px 13px;border-radius:999px;font-size:12px;letter-spacing:1px;text-transform:uppercase}
.hero h1{font-size:clamp(38px,9vw,68px);line-height:1;margin:20px 0 14px;letter-spacing:-2px}
.hero p,.intro{max-width:650px;margin:auto;color:var(--muted);line-height:1.65}
.btn,button{cursor:pointer}
.btn{display:inline-flex;align-items:center;justify-content:center;margin-top:20px;padding:13px 18px;border-radius:12px;background:linear-gradient(135deg,#f22b3d,#b90e1d);color:#fff;text-decoration:none;font-weight:800;border:1px solid #f34b59}
section{padding:28px 0 55px}
.heading{text-align:center;margin-bottom:22px}.heading h2{margin:0 0 8px;font-size:29px}.heading p{margin:0;color:var(--muted)}
.controls{display:grid;grid-template-columns:1fr;gap:10px;margin:20px 0}
input,select,.filter{width:100%;padding:13px;border-radius:11px;background:#111;color:#fff;border:1px solid #3a3a3a;font:inherit}
.filters{display:flex;gap:8px;flex-wrap:wrap}.filter{width:auto;padding:10px 14px;font-weight:700}.filter.active{background:var(--red);border-color:var(--red)}
.counter{color:#ff737d;font-weight:700;margin:12px 0}
.catalog-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px}
.perfume-card{overflow:hidden;background:linear-gradient(155deg,#181818,#0d0d0d);border:1px solid #343434;border-radius:18px;padding:14px;transition:transform .2s,border-color .2s}
.perfume-card:hover{transform:translateY(-3px);border-color:#8e202b}
.image-wrap{height:220px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.perfume-img{width:100%;height:100%;object-fit:contain;display:block}
.image-fallback{display:none;color:#222;text-align:center;padding:18px;font-weight:800}
.perfume-card h3{font-size:16px;line-height:1.3;margin:13px 0 5px}
.category-label{color:#ff737d;font-size:11px;text-transform:uppercase;letter-spacing:.7px}
.price-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:12px 0}
.price-row select{padding:9px;min-width:0}
.add{width:100%;padding:12px;border-radius:10px;background:linear-gradient(135deg,#f22b3d,#b90e1d);color:white;border:1px solid #f34b59;font-weight:800}
.empty{text-align:center;color:#aaa;padding:35px}
.cart-panel{margin:30px 0;padding:18px;background:#111;border:1px solid #333;border-radius:16px}
.cart-panel h2{margin-top:0}.cart-item{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #292929}.cart-item button{background:none;color:#ff737d;border:0}
footer{border-top:1px solid #282828;padding:25px 0 35px;text-align:center;color:#999;font-size:13px}
@media(min-width:700px){.controls{grid-template-columns:1fr 220px auto}.hero{padding-top:85px}}
@media(max-width:480px){.nav{align-items:flex-start;padding-top:12px;padding-bottom:12px;flex-direction:column}.catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.image-wrap{height:160px}.perfume-card{padding:10px}.perfume-card h3{font-size:14px}.price-row{align-items:stretch;flex-direction:column}}
</style>
</head>
<body>
<header>
  <div class="wrap nav">
    <div class="brand">Aromas <span>Art</span></div>
    <nav><a href="#catalogo">Catálogo</a>　<a href="#carrito">Carrito (<span id="cartCount">0</span>)</a></nav>
  </div>
</header>
<main>
  <div class="wrap hero">
    <div class="badge">Perfumería · Catálogos</div>
    <h1>Encuentra tu<br><span>próximo aroma.</span></h1>
    <p>Busca por nombre y explora fragancias femeninas y masculinas. Selecciona el tamaño y agrega tus favoritos al carrito.</p>
    <a class="btn" href="#catalogo">Ver perfumes ↓</a>
  </div>
  <section id="catalogo" class="wrap">
    <div class="heading"><h2>Descubre tu fragancia</h2><p>Busca por nombre o filtra por categoría.</p></div>
    <div class="controls">
      <input id="search" type="search" placeholder="🔎 Buscar perfume por nombre..." autocomplete="off">
      <select id="sort"><option value="featured">Descubrir fragancias</option><option value="az">Nombre: A–Z</option><option value="za">Nombre: Z–A</option></select>
      <button class="filter" id="shuffle">↻ Mezclar</button>
    </div>
    <div class="filters">
      <button class="filter active" data-category="todos">Todos</button>
      <button class="filter" data-category="masculino">Masculinos</button>
      <button class="filter" data-category="femenino">Femeninos</button>
    </div>
    <div class="counter" id="counter" aria-live="polite"></div>
    <div class="catalog-grid" id="grid"></div>
    <div class="empty" id="empty" hidden>No encontramos ese perfume. Prueba otro nombre.</div>
  </section>
  <section class="wrap" id="carrito">
    <div class="cart-panel"><h2>🛒 Tu carrito</h2><div id="cartItems">Todavía no has agregado perfumes.</div><p><strong>Total: <span id="total">RD$0</span></strong></p><button class="add" id="clearCart" type="button">Vaciar carrito</button></div>
  </section>
</main>
<footer><div class="wrap">Aromas Art · Catálogo de perfumes</div></footer>
<script>
(function(){
  // Para que una foto aparezca, su archivo debe estar en /blottles/ y su nombre
  // debe coincidir con el nombre configurado abajo. Las rutas distinguen mayúsculas.
  const perfumes = [
    {name:"POLO BLUE",cat:"masculino"},{name:"POLO RED",cat:"masculino"},
    {name:"360 RED",cat:"masculino"},{name:"INVICTUS",cat:"masculino"},
    {name:"PHANTOM",cat:"masculino"},{name:"1 MILLION",cat:"masculino"},
    {name:"BLACK XS",cat:"masculino"},{name:"NAUTICA VOYAGE",cat:"masculino"},
    {name:"TOY BOY",cat:"masculino"},{name:"EXPLORER",cat:"masculino"},
    {name:"EROS",cat:"masculino"},{name:"EROS FLAME",cat:"masculino"},
    {name:"BLEU DE CHANEL",cat:"masculino"},{name:"SAUVAGE",cat:"masculino"},
    {name:"ACQUA DI GIO",cat:"masculino"},{name:"STRONGER WITH YOU",cat:"masculino"},
    {name:"OUD FOR GLORY",cat:"masculino"},{name:"ASAD",cat:"masculino"},
    {name:"KHAMRAH",cat:"masculino"},{name:"BACCARAT ROUGE 540",cat:"masculino"},
    {name:"FANTASY",cat:"femenino",image:"f-209-fantasy.jpg"},
    {name:"FANTASY IN BLOOM",cat:"femenino",image:"f-210-fantasy-in-bloom.jpg"},
    {name:"BURBERRY HER",cat:"femenino",image:"f-211-burberry-her.jpg"},
    {name:"OMNIA CORAL",cat:"femenino",image:"f-212-omnia-coral.jpg"},
    {name:"212 SEXY",cat:"femenino",image:"f-214-212-sexy.jpg"},
    {name:"212 VIP ROSÉ",cat:"femenino",image:"f-215-212-vip-ros.jpg"},
    {name:"GOOD GIRL",cat:"femenino",image:"f-217-good-girl.jpg"},
    {name:"COCO MADEMOISELLE",cat:"femenino",image:"f-220-coco-mademoiselle.jpg"},
    {name:"CHANCE",cat:"femenino",image:"f-221-chance.jpg"},
    {name:"GOOD GIRL BLUSH",cat:"femenino",image:"f-222-good-girl-blush.jpg"},
    {name:"YARA",cat:"femenino"},{name:"BRIGHT CRYSTAL",cat:"femenino"},
    {name:"DELINA",cat:"femenino"},{name:"YARA CANDY",cat:"femenino"},
    {name:"BOMBSHELL",cat:"femenino"},{name:"TOY 2",cat:"femenino"},
    {name:"MISS DIOR",cat:"femenino"},{name:"J'ADORE",cat:"femenino"},
    {name:"OLYMPEA",cat:"femenino"},{name:"MY WAY",cat:"femenino"}
  ];
  const sizes=[{ml:15,price:350},{ml:30,price:800},{ml:50,price:1200},{ml:100,price:1700}];
  let category="todos", cart=[];
  const grid=document.getElementById("grid"), search=document.getElementById("search"), sort=document.getElementById("sort");
  const slug=s=>s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
  function imageName(p){return p.image || (slug(p.name)+".jpg");}
  function render(){
    let list=perfumes.filter(p=>(category==="todos"||p.cat===category)&&p.name.toLowerCase().includes(search.value.trim().toLowerCase()));
    if(sort.value==="az")list.sort((a,b)=>a.name.localeCompare(b.name));
    if(sort.value==="za")list.sort((a,b)=>b.name.localeCompare(a.name));
    document.getElementById("counter").textContent=list.length+" perfumes";
    document.getElementById("empty").hidden=list.length!==0;
    grid.innerHTML=list.map(p=>{
      const src="./blottles/"+imageName(p);
      return `<article class="perfume-card">
        <div class="image-wrap">
          <img class="perfume-img" src="${src}" alt="${p.name}" loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
          <div class="image-fallback">Aromas Art<br><small>${p.name}</small><br><small>Imagen pendiente</small></div>
        </div>
        <div class="category-label">${p.cat==="femenino"?"Femenino":"Masculino"}</div>
        <h3>${p.name}</h3>
        <div class="price-row"><select aria-label="Tamaño para ${p.name}" class="size">${sizes.map(s=>`<option value="${s.ml}" data-price="${s.price}">${s.ml} ml — RD$${s.price.toLocaleString("es-DO")}</option>`).join("")}</select></div>
        <button class="add" data-add="${p.name}">Agregar al carrito</button>
      </article>`;
    }).join("");
  }
  function renderCart(){
    document.getElementById("cartCount").textContent=cart.reduce((n,x)=>n+x.qty,0);
    document.getElementById("cartItems").innerHTML=cart.length?cart.map((x,i)=>`<div class="cart-item"><span>${x.name} · ${x.ml} ml × ${x.qty}<br><small>RD$${(x.price*x.qty).toLocaleString("es-DO")}</small></span><span><button data-remove="${i}">Quitar</button></span></div>`).join(""):"Todavía no has agregado perfumes.";
    document.getElementById("total").textContent="RD$"+cart.reduce((n,x)=>n+x.price*x.qty,0).toLocaleString("es-DO");
  }
  grid.addEventListener("click",e=>{
    const btn=e.target.closest("[data-add]");if(!btn)return;
    const card=btn.closest(".perfume-card"), select=card.querySelector(".size"), opt=select.selectedOptions[0];
    const item={name:btn.dataset.add,ml:Number(select.value),price:Number(opt.dataset.price),qty:1};
    const found=cart.find(x=>x.name===item.name&&x.ml===item.ml);
    if(found)found.qty++;else cart.push(item);renderCart();
    btn.textContent="¡Agregado!";setTimeout(()=>btn.textContent="Agregar al carrito",900);
  });
  document.getElementById("cartItems").addEventListener("click",e=>{
    const b=e.target.closest("[data-remove]");if(!b)return;cart.splice(Number(b.dataset.remove),1);renderCart();
  });
  document.getElementById("clearCart").addEventListener("click",()=>{cart=[];renderCart();});
  document.querySelectorAll("[data-category]").forEach(b=>b.addEventListener("click",()=>{
    category=b.dataset.category;document.querySelectorAll("[data-category]").forEach(x=>x.classList.toggle("active",x===b));render();
  }));
  search.addEventListener("input",render);sort.addEventListener("change",render);
  document.getElementById("shuffle").addEventListener("click",()=>{perfumes.sort(()=>Math.random()-.5);sort.value="featured";render();});
  render();renderCart();
})();
</script>
</body>
</html>
